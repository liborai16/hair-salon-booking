{
  "name": "hair-salon-booking",
  "version": "0.0.1",
  "private": true,
  "description": "Case study: rezervační systém pro kadeřnictví (Vite + React + Firebase)",
  "workspaces": [
    "functions",
    "packages/shared",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "test": "npm run test --workspaces --if-present",
    "emulators": "firebase emulators:start",
    "seed": "npm run build --workspace=@hsb/shared && node scripts/seed.mjs",
    "seed:prod": "npm run build --workspace=@hsb/shared && node scripts/seed.mjs --target=production"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "firebase-tools": "^15.18.0",
    "vitest": "^2.1.9"
  }
}
