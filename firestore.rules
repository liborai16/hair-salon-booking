rules_version = '2';

// ============================================================
// Firestore Security Rules — A.2 active (post-D-018 + post-seed).
//
// Helpers are CLAIMS-BASED (request.auth.token.role + .linkedStylistId)
// rather than the Day 1 skeleton's userDoc() Firestore-lookup pattern.
// Custom claims are server-issued (admin.auth().setCustomUserClaims() in
// seed.mjs), JWT-cached, and incur ZERO Firestore reads per rule eval.
// Per Firebase best practice; supersedes pre-claims skeleton design.
//
// Permission model per D-013 PII split:
//   - Public read:  services, stylists, salonSettings, bookings (no PII)
//   - Staff read:   bookingCustomers, customerProfiles, absences, notifications
//   - Owner write:  services, stylists, salonSettings, absences
//   - Staff write:  bookings (granularity at UI/business logic, not rules)
//   - CF-only:      bookingCustomers, customerProfiles, notifications
//   - Owner delete: bookings (safety net — normal cancellation = status update)
//
// Admin SDK bypasses rules entirely — Cloud Functions (createBooking,
// manageBookingByToken) and seed.mjs are free of the gates below.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper functions (claims-based) ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function hasRole(r) {
      return isAuthenticated() && request.auth.token.role == r;
    }
    function isOwner() {
      return hasRole('owner');
    }
    function isStaff() {
      return isAuthenticated()
        && request.auth.token.role in ['owner', 'receptionist', 'stylist'];
    }
    function isStylistFor(stylistId) {
      return hasRole('stylist') && request.auth.token.linkedStylistId == stylistId;
    }

    // services/{id} — PUBLIC READ (booking flow needs service list), OWNER WRITE
    match /services/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // stylists/{id} — PUBLIC READ (booking flow displays team), OWNER WRITE
    match /stylists/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // absences/{id} — PUBLIC READ (slot picker needs availability windows;
    // `reason` field is internal note, not customer PII per D-013 — MVP
    // tradeoff vs CF aggregation endpoint), OWNER WRITE
    match /absences/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // bookings/{id} — PUBLIC READ (no PII per D-013 — slot availability is public),
    // STAFF WRITE for create/update (admin walk-ins, status transitions),
    // OWNER-ONLY DELETE (A1 safety net — normal cancellation is status update,
    // not hard delete; via manageBookingByToken CF for clients).
    match /bookings/{id} {
      allow read: if true;
      allow create, update: if isStaff();
      allow delete: if isOwner();
    }

    // bookingCustomers/{bookingId} — STAFF-ONLY READ (PII per D-013), CF-only WRITE
    match /bookingCustomers/{bookingId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // customerProfiles/{phoneHash} — STAFF-ONLY READ (PII aggregated), CF-only WRITE
    match /customerProfiles/{phoneHash} {
      allow read: if isStaff();
      allow write: if false;
    }

    // users/{uid} — SELF READ + OWNER READ, OWNER WRITE only
    // Self-read for client app to load own profile after login; role
    // mutation is owner privilege (no self-promotion).
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isOwner());
      allow write: if isOwner();
    }

    // salonSettings/{id} — PUBLIC READ (IBAN for SPAYD QR, hours for booking
    // display), OWNER WRITE
    match /salonSettings/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // notifications/{id} — STAFF-ONLY READ, CF-only WRITE
    match /notifications/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Default deny — anything not matched above (A2: AT END as fallback)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
