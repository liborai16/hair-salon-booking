{
  "name": "@hsb/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Shared TypeScript types and utilities for hair-salon-booking (used by web and functions)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "rimraf": "^6.0.0"
  }
}
